{
  "compilerOptions": {
    "target": "ES2022", "module": "Node16", "moduleResolution": "Node16",
    "types": ["node", "vscode"],
    "rootDir": ".", "outDir": "dist", "strict": true,
    "noUncheckedIndexedAccess": true, "noImplicitOverride": true,
    "esModuleInterop": true, "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true, "sourceMap": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
